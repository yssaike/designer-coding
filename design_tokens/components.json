{
  "button": {
    "borderRadius": "2px",
    "paddingX": "12px",
    "paddingY": "4px",
    "shadow": "3px 4px 24px rgba(0,0,0,0.07)",
    "fontSize": "1px",
    "fontWeight": "16px",
    "gap": "20px"
  },
  "input": {
    "borderRadius": "16px",
    "paddingX": "16px",
    "paddingY": "4px",
    "borderWidth": "4px",
    "fontSize": "12px",
    "shadow": "4px 6px 15px rgba(0,0,0,0.13)"
  },
  "card": {
