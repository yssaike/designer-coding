{
  "button": {
    "borderRadius": "2px",
    "paddingX": "12px",
    "paddingY": "4px",
    "shadow": "3px 4px 24px rgba(0,0,0,0.07)",
    "fontSize": "1px",
    "fontWeight": "16px",
    "gap": "20px"
  },
  "input": {
    "borderRadius": "24px",
    "paddingX": "16px",
    "paddingY": "12px",
    "borderWidth": "8px",
    "fontSize": "8px",
    "shadow": "3px 3px 23px rgba(0,0,0,0.1)"
  },
  "card": {
    "borderRadius": "4px",
    "padding": "16px",
    "shadow": "0px 2px 10px rgba(0,0,0,0.11)",
    "borderWidth": "8px",
    "gap": "4px"
  },
  "modal": {
    "borderRadius": "6px",
    "padding": "20px",
    "shadow": "2px 2px 4px rgba(0,0,0,0.15)",
