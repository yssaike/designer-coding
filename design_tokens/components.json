{
  "button": {
    "borderRadius": "2px",
    "paddingX": "12px",
    "paddingY": "8px",
    "shadow": "2px 3px 9px rgba(0,0,0,0.06)",
    "fontSize": "16px",
    "fontWeight": "16px",
    "gap": "16px"
  },
  "input": {
    "borderRadius": "4px",
    "paddingX": "16px",
    "paddingY": "20px",
    "borderWidth": "12px",
    "fontSize": "16px",
    "shadow": "3px 8px 7px rgba(0,0,0,0.13)"
  },
  "card": {
    "borderRadius": "12px",
    "padding": "24px",
    "shadow": "0px 2px 10px rgba(0,0,0,0.11)",
    "borderWidth": "16px",
    "gap": "8px"
  },
  "modal": {
    "borderRadius": "24px",
    "padding": "24px",
    "shadow": "4px 7px 13px rgba(0,0,0,0.16)",
    "maxWidth": "2px",
    "gap": "12px"
  },
  "tooltip": {
    "borderRadius": "9999px",
    "paddingX": "4px",
    "paddingY": "8px",
